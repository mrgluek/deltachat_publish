# Delta Chat Account Credentials
# Option 1: Auto-create a new account on a Chatmail server (Recommended & Simplest)
RELAY=chatmail.uk

# Option 2: Use an existing email account
# ADDR=publishbot@gluek.info
# MAIL_PW=your_email_password_here

# Bot Profile Metadata
DISPLAY_NAME="Delta Chat Publish Bot"
STATUS_TEXT="Publishes blog posts directly to Git/Astro via Delta Chat"
AVATAR_PATH=avatar.png

# Forgejo / Gitea REST API Credentials
FORGEJO_URL=https://git.gluek.info
FORGEJO_TOKEN=your_personal_access_token_here
FORGEJO_REPO_OWNER=gluek
FORGEJO_REPO_NAME=gluek.info
FORGEJO_BRANCH=main

# Astro Blog Layout Configuration
# Options for BLOG_POST_FORMAT:
#   single_file -> src/content/blog/<slug>.md and public/images/<slug>/
#   folder      -> src/content/blog/<slug>/index.md and src/content/blog/<slug>/ (Astro Nano style)
BLOG_POST_FORMAT=single_file
BLOG_CONTENT_PATH=src/content/blog
BLOG_IMAGES_PATH=public/images
BLOG_IMAGE_URL_PREFIX=/images
BLOG_PUBLIC_URL_PREFIX=https://gluek.info/blog

# Bot Admin Security
ADMIN_DC_EMAIL=gluek@gluek.info
ADMIN_DC_FINGERPRINT=

# Healthchecks Ping URL (Optional)
MONITOR_URL=
